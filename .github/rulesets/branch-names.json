{
  "name": "branch-names",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/feat/**",
        "refs/heads/fix/**",
        "refs/heads/chore/**",
        "refs/heads/design/**",
        "refs/heads/archilles-bot/**",
        "refs/heads/release-please--**"
      ]
    }
  },
  "rules": [{ "type": "creation" }]
}
