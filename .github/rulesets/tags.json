{
  "name": "version-tags",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_id": "${ARCHILLES_RELEASE_APP_ID}", "actor_type": "Integration", "bypass_mode": "always" }
  ],
  "conditions": {
    "ref_name": { "include": ["refs/tags/v*"], "exclude": [] }
  },
  "rules": [{ "type": "creation" }, { "type": "update" }, { "type": "deletion" }]
}
