# Compile gate layer 1 — generated by `archilles diff --gate`, never committed.
# A fresh clone must not compile until the diff passes once.
internal/archgate/gate_gen.go

# Build output. `/archilles` matches the binary AND the design directory of the
# same name, so the directory is negated back in - it is the product's input and
# must be tracked.
/archilles
!/archilles/
/archilles-vet
/archilles-toolexec
/dist/

# Test output
coverage.out
coverage.html

# Local overrides
.claude/settings.local.json
.env

# GitHub App credentials staged by scripts/create-app.mjs — never commit
.secrets/
